# Public template only. Copy to .env on the server; never commit the real .env file.
STACK_NAME=onepanel-data-stack
TZ=UTC

# Shared Docker network used by application containers.
DOCKER_NETWORK_NAME=onepanel-data-net

# Host directory for PostgreSQL custom-format backups.
BACKUP_DIR=/opt/onepanel-data-stack/backups
BACKUP_RETENTION_DAYS=14

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=GENERATED_ON_INSTALL
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# Optional Adminer profile: tools
ADMINER_IMAGE=adminer:4.8.1-standalone
ADMINER_BIND_IP=127.0.0.1
ADMINER_PORT=8080

# Optional Valkey profile: cache
VALKEY_IMAGE=valkey/valkey:8-alpine
VALKEY_PASSWORD=GENERATED_ON_INSTALL
VALKEY_BIND_IP=127.0.0.1
VALKEY_PORT=6379
